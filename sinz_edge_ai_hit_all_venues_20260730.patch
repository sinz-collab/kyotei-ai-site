+function normalizeResultOrder(value) {
+  if (Array.isArray(value)) {
+    return value.map((n) => String(n).trim()).filter(Boolean).slice(0, 3);
+  }
+  return String(value || "")
+    .replace(/[＞>→]/g, "-")
+    .split(/[-,\s]+/)
+    .map((n) => n.trim())
+    .filter(Boolean)
+    .slice(0, 3);
